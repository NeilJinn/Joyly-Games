{
  "id": "token.flyToTarget",
  "name": "Token Fly To Target",
  "version": "1.0.0",
  "category": "token",
  "description": "Move a token, vote, or score chip from a source element to a target element.",
  "requiredSlots": [
    {
      "id": "sourceElement",
      "label": "Source element",
      "type": "element",
      "required": true,
      "description": "The token or chip that starts moving."
    },
    {
      "id": "targetElement",
      "label": "Target element",
      "type": "element",
      "required": true,
      "description": "The destination element or board area."
    }
  ],
  "optionalSlots": [],
