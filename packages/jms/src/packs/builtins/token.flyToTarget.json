        "params": {
          "strength": 14,
          "color": "#8dffce",
          "size": 4,
          "cadence": 2
        }
      },
      {
        "id": "token-flyToTarget.magnet",
        "type": "magnettotarget",
        "label": "Magnet",
        "start": 0.72,
        "duration": 0.58,
        "lane": 1,
        "slot": "sourceElement",
        "params": {
          "y": 18,
          "arc": 20,
          "bendX": 12,
          "scale": 0.96,
          "opacity": 1
        }
      },
      {
        "id": "token-flyToTarget.flash",
        "type": "flash",
        "label": "Flash",
        "start": 0.84,
        "duration": 0.14,
        "lane": 1,
