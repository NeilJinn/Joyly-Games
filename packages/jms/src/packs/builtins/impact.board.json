{
  "id": "impact.board",
  "name": "Impact Board",
  "version": "1.0.0",
  "category": "feedback",
  "description": "Use for correct/incorrect hits, board confirmations, and crisp feedback moments.",
  "requiredSlots": [
    {
      "id": "targetElement",
      "label": "Target element",
      "type": "element",
      "required": true,
      "description": "The board, tile, or panel that receives the impact."
    }
  ],
  "optionalSlots": [],
  "timeline": {
    "duration": 1.5,
    "blocks": [
      {
        "id": "impact-board.hit",
        "type": "impactslam",
        "label": "Impact hit",
        "start": 0,
        "duration": 0.58,
        "lane": 0,
        "slot": "targetElement",
        "params": {
          "magnitude": 18,
          "cycles": 2,
          "scaleX": 1.16,
          "scaleY": 0.84,
          "strength": 42,
          "color": "#ff5d5d"
        }
      },
      {
        "id": "impact-board.wiggle",
        "type": "customwiggle",
        "label": "Wiggle",
        "start": 0.16,
        "duration": 0.48,
        "lane": 1,
        "slot": "targetElement",
        "params": {
          "magnitude": 9,
          "cycles": 5
        }
      },
      {
        "id": "impact-board.flash",
        "type": "flash",
        "label": "Flash",
        "start": 0.02,
        "duration": 0.16,
        "lane": 1,
        "slot": "targetElement",
        "params": {
          "strength": 48,
          "color": "#ff7d7d",
          "opacity": 1
        }
      },
      {
        "id": "impact-board.squash",
        "type": "squashstretch",
        "label": "Squash",
        "start": 0.1,
        "duration": 0.36,
        "lane": 1,
        "slot": "targetElement",
        "params": {
          "scaleX": 1.18,
          "scaleY": 0.82
        }
      },
      {
        "id": "impact-board.pulse",
        "type": "stagepulse",
        "label": "Recover",
        "start": 0.26,
        "duration": 0.48,
        "lane": 0,
        "slot": "targetElement",
        "params": {
          "scale": 1.12,
          "strength": 30,
          "color": "#ff5d5d"
        }
      },
      {
        "id": "impact-board.hold",
        "type": "finalhold",
        "label": "Hold",
        "start": 0.9,
        "duration": 0.38,
        "lane": 0,
        "slot": "targetElement",
        "params": {
          "opacity": 1,
          "scale": 1
        }
      }
    ]
  },
  "defaultParams": {
    "color": "#ff5d5d"
  },
  "themeSlots": {
    "default": {
      "defaultParams": {
        "color": "#ff5d5d"
      }
    },
    "midnight": {
      "defaultParams": {
        "color": "#ff7dc7"
      }
    },
    "sunset": {
      "defaultParams": {
        "color": "#f4c542"
      }
    }
  },
  "assetSlots": {
    "boardImage": {
      "type": "image",
      "label": "Board image",
      "description": "Optional board or tile artwork that receives the hit.",
      "required": false
    }
  },
  "particleHooks": {
    "impactBurst": {
      "type": "burst",
      "label": "Impact burst",
      "description": "Tiny burst on confirmation."
    }
  },
  "lottieHooks": {},
  "soundHooks": {
    "impact": {
      "key": "sfx.impact.board",
      "label": "Impact sound"
    }
  },
  "reducedMotionFallback": {
    "mode": "simplified",
    "title": "Impact without the wobble",
    "description": "Reduced-motion mode keeps the confirmation visible with a single light pulse.",
    "timeline": {
    "duration": 0.08,
      "blocks": [
        {
          "id": "impact-board.reduced",
          "type": "glow",
          "label": "Confirm",
          "start": 0,
          "duration": 0.08,
          "slot": "targetElement",
          "params": {
            "strength": 8,
            "color": "#ff5d5d"
          }
        }
      ]
    }
  },
  "metadata": {
    "source": "m3-library",
    "previewExample": "JMS.playPack('impact.board', { targetElement: boardEl, theme: 'midnight' })"
  }
}
